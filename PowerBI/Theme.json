{
  "name": "Glassmorphic Dark Recruitment",
  "dataColors": [
    "#0EA5E9",
    "#3B82F6",
    "#10B981",
    "#EF4444",
    "#F59E0B",
    "#8B5CF6",
    "#EC4899",
    "#6B7280"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#0EA5E9",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "transparency": 15
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#334155"
              }
            },
            "radius": 12
          }
        ],
        "visualTooltip": [
          {
            "type": "Default",
            "titleFontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "background": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Left"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "fontSize": 9
          }
        ],
        "cardTitle": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0EA5E9"
              }
            },
            "fontSize": 20,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
